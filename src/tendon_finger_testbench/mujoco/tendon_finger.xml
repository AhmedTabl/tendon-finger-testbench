<mujoco model="tendon_finger_testbench">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.80665" integrator="RK4"/>

  <visual>
    <headlight diffuse="0.8 0.8 0.8" ambient="0.35 0.35 0.35"/>
    <quality shadowsize="2048"/>
  </visual>

  <asset>
    <material name="base_gray" rgba="0.45 0.48 0.52 1"/>
    <material name="motor_dark" rgba="0.08 0.10 0.12 1"/>
    <material name="spool_blue" rgba="0.10 0.32 0.78 1"/>
    <material name="finger_green" rgba="0.12 0.55 0.34 1"/>
    <material name="tendon_red" rgba="0.84 0.18 0.16 1"/>
  </asset>

  <worldbody>
    <light name="key" pos="0 -1.2 1.2" dir="0 1 -1"/>
    <geom name="floor" type="plane" size="0.5 0.5 0.01" rgba="0.92 0.92 0.9 1"/>

    <body name="base" pos="0 0 0.02">
      <geom name="base_plate" type="box" size="0.13 0.05 0.01" material="base_gray"/>
      <geom name="hinge_block" type="box" pos="0 0 0.04" size="0.016 0.04 0.035" material="base_gray"/>
    </body>

    <body name="motor_assembly" pos="-0.075 0 0.055">
      <geom name="motor_can" type="cylinder" euler="0 1.57079632679 0"
            size="0.028 0.027" material="motor_dark"/>
      <geom name="spool_visual" type="cylinder" euler="0 1.57079632679 0"
            pos="0.035 0 0" size="0.012 0.018" material="spool_blue"/>
    </body>

    <!-- Static cable path visuals. Tendon dynamics are modeled in Python. -->
    <geom name="cable_spool_to_hinge" type="capsule"
          fromto="-0.04 0 0.067 -0.005 0 0.063" size="0.002" material="tendon_red"/>
    <geom name="cable_hinge_to_link" type="capsule"
          fromto="-0.005 0 0.063 0.035 0 0.064" size="0.002" material="tendon_red"/>

    <body name="finger" pos="0 0 0.055">
      <joint name="finger_joint" type="hinge" axis="0 1 0"
             limited="true" range="-0.05 1.35" damping="0.008"
             frictionloss="0.012" armature="0.0022"/>
      <geom name="finger_link" type="capsule" fromto="0 0 0 0.09 0 0"
            size="0.012" mass="0.055" material="finger_green"/>
      <geom name="fingertip_pad" type="sphere" pos="0.09 0 0"
            size="0.016" rgba="0.03 0.14 0.10 1"/>
      <site name="fingertip" pos="0.09 0 0" size="0.006" rgba="1 1 1 1"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="finger_joint_torque" joint="finger_joint"
           gear="1.0" ctrllimited="true" ctrlrange="-0.6 0.6"/>
  </actuator>
</mujoco>

