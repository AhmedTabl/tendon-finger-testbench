<mujoco model="tendon_finger_testbench">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.80665" integrator="implicitfast">
    <flag energy="enable"/>
  </option>

  <statistic center="0 0 0.085" extent="0.28"/>

  <visual>
    <global azimuth="145" elevation="-22" offwidth="960" offheight="720"/>
    <headlight diffuse="0.78 0.78 0.78" ambient="0.32 0.32 0.32"
               specular="0.25 0.25 0.25"/>
    <quality shadowsize="4096"/>
  </visual>

  <default>
    <joint solreflimit="0.004 1" solimplimit="0.95 0.99 0.001"/>
    <geom friction="0.7 0.01 0.001" solref="0.004 1"
          solimp="0.95 0.99 0.001" margin="0.0002"
          contype="0" conaffinity="0"/>
    <site type="sphere" size="0.0025" rgba="0.95 0.75 0.12 1"/>
  </default>

  <asset>
    <texture name="floor_grid" type="2d" builtin="checker"
             rgb1="0.18 0.20 0.22" rgb2="0.28 0.30 0.32"
             mark="edge" markrgb="0.45 0.47 0.49" width="512" height="512"/>
    <material name="floor" texture="floor_grid" texuniform="true"
              texrepeat="8 8" reflectance="0.12"/>
    <material name="aluminum" rgba="0.55 0.58 0.62 1" metallic="0.65" roughness="0.32"/>
    <material name="black_polymer" rgba="0.045 0.055 0.065 1"
              metallic="0.1" roughness="0.52"/>
    <material name="motor_blue" rgba="0.04 0.22 0.48 1" metallic="0.5" roughness="0.3"/>
    <material name="spool" rgba="0.10 0.42 0.78 1" metallic="0.55" roughness="0.25"/>
    <material name="finger" rgba="0.08 0.48 0.30 1" metallic="0.05" roughness="0.48"/>
    <material name="rubber" rgba="0.025 0.07 0.055 1" roughness="0.86"/>
    <material name="bearing" rgba="0.22 0.24 0.27 1" metallic="0.85" roughness="0.2"/>
    <material name="cable" rgba="0.86 0.10 0.08 1" roughness="0.7"/>
    <material name="marker" rgba="0.98 0.83 0.12 1" emission="0.08"/>
  </asset>

  <worldbody>
    <light name="key" pos="-0.25 -0.35 0.55" dir="0.25 0.35 -0.8"
           directional="true" castshadow="true"/>
    <light name="fill" pos="0.30 0.25 0.30" dir="-0.3 -0.2 -0.4"
           directional="true" diffuse="0.35 0.38 0.42"/>
    <geom name="floor" type="plane" size="0.65 0.65 0.02" material="floor"
          contype="1" conaffinity="1"/>

    <body name="testbench">
      <geom name="base_plate" type="box" pos="0 0 0.012"
            size="0.175 0.075 0.012" material="aluminum"/>
      <geom name="left_rail" type="box" pos="-0.01 0.058 0.037"
            size="0.15 0.008 0.025" material="black_polymer"/>
      <geom name="right_rail" type="box" pos="-0.01 -0.058 0.037"
            size="0.15 0.008 0.025" material="black_polymer"/>

      <!-- Generic 42 mm-class geared motor housing. The housing is fixed;
           only the internal shaft body below rotates. -->
      <body name="motor_housing" pos="-0.118 0 0.075">
        <geom name="motor_can" type="cylinder" size="0.026 0.031"
              euler="1.57079632679 0 0" material="motor_blue"/>
        <geom name="motor_front_plate" type="cylinder" pos="0 -0.034 0"
              size="0.029 0.003" euler="1.57079632679 0 0" material="aluminum"/>
        <geom name="motor_rear_plate" type="cylinder" pos="0 0.034 0"
              size="0.029 0.003" euler="1.57079632679 0 0" material="aluminum"/>

        <body name="motor_rotor">
          <joint name="motor_shaft_joint" type="hinge" axis="0 1 0"
                 limited="true" range="0 100"
                 damping="0.0002" frictionloss="0.0003" armature="0.00012"/>
          <geom name="motor_shaft" type="cylinder" pos="0 -0.041 0"
                size="0.004 0.010" euler="1.57079632679 0 0"
                material="bearing" contype="0" conaffinity="0"/>
          <geom name="motor_encoder_disc" type="cylinder" pos="0 0.040 0"
                size="0.019 0.002" euler="1.57079632679 0 0"
                material="black_polymer" contype="0" conaffinity="0"/>
          <geom name="motor_encoder_marker" type="box" pos="0.0105 0.042 0"
                size="0.0085 0.001 0.0015" material="marker"
                contype="0" conaffinity="0"/>
          <geom name="motor_shaft_marker" type="box" pos="0.008 -0.052 0"
                size="0.006 0.0012 0.0015" material="marker"
                contype="0" conaffinity="0"/>
        </body>
      </body>

      <!-- Gearbox output and cable spool. The equality constraint below maps
           motor-shaft angle to this output angle through the editable ratio. -->
      <body name="spool_output" pos="-0.073 0 0.075">
        <joint name="spool_joint" type="hinge" axis="0 1 0"
               damping="0.0002" frictionloss="0.0002" armature="0.00035"/>
        <geom name="spool_hub" type="cylinder" size="0.012 0.012"
              euler="1.57079632679 0 0" material="spool"/>
        <geom name="spool_left_flange" type="cylinder" pos="0 0.014 0"
              size="0.018 0.002" euler="1.57079632679 0 0" material="spool"/>
        <geom name="spool_right_flange" type="cylinder" pos="0 -0.014 0"
              size="0.018 0.002" euler="1.57079632679 0 0" material="spool"/>
        <geom name="spool_cable_layer" type="cylinder" size="0.0128 0.010"
              euler="1.57079632679 0 0" material="cable"
              contype="0" conaffinity="0"/>
        <geom name="spool_rotation_marker" type="box" pos="0.009 -0.016 0"
              size="0.008 0.001 0.0016" material="marker"
              contype="0" conaffinity="0"/>
        <site name="spool_exit" pos="0.002 -0.017 0.0126"
              size="0.0022" material="cable"/>
      </body>

      <body name="guide_pulley" pos="-0.029 -0.045 0.128">
        <joint name="guide_pulley_joint" type="hinge" axis="0 1 0"
               damping="0.00001" armature="0.000005"/>
        <geom name="guide_axle" type="cylinder" size="0.0035 0.010"
              euler="1.57079632679 0 0" material="bearing"/>
        <geom name="guide_pulley_visual" type="cylinder" size="0.009 0.006"
              euler="1.57079632679 0 0" material="aluminum"/>
        <geom name="guide_rotation_marker" type="box" pos="0.0055 -0.007 0"
              size="0.0045 0.001 0.0013" material="marker"
              contype="0" conaffinity="0"/>
        <geom name="guide_wrap" type="sphere" size="0.009"
              rgba="0 0 0 0" contype="0" conaffinity="0"/>
        <site name="guide_side" pos="-0.009 0 0" rgba="0 0 0 0"/>
      </body>

      <body name="finger_mount" pos="0.005 0 0.158">
        <geom name="mount_left_cheek" type="box" pos="0 0.031 0"
              size="0.015 0.007 0.031" material="black_polymer"/>
        <geom name="mount_right_cheek" type="box" pos="0 -0.031 0"
              size="0.015 0.007 0.031" material="black_polymer"/>
        <geom name="joint_bearing" type="cylinder" size="0.012 0.042"
              euler="1.57079632679 0 0" material="bearing"/>

        <body name="finger_link">
          <joint name="finger_joint" type="hinge" axis="0 -1 0"
                 limited="true" range="-0.05 1.35"
                 damping="0.0015" frictionloss="0.0008"
                 stiffness="0.02" springref="0" armature="0.00018"/>
          <geom name="finger_core" type="capsule" fromto="0 0 0 0 0 -0.09"
                size="0.011" mass="0.055" rgba="0 0 0 0"
                contype="1" conaffinity="1"/>
          <geom name="finger_shell" type="box" pos="0 0 -0.045"
                size="0.009 0.014 0.043" material="finger"
                contype="0" conaffinity="0"/>
          <geom name="finger_horn" type="capsule"
                fromto="-0.002 -0.014 -0.003 -0.018 -0.045 -0.003"
                size="0.0032" material="aluminum"/>
          <site name="finger_tendon_anchor" pos="-0.018 -0.045 -0.003"
                size="0.003" material="cable"/>
          <geom name="fingertip_pad" type="capsule"
                fromto="-0.003 0 -0.081 -0.003 0 -0.094"
                size="0.014" material="rubber"
                contype="1" conaffinity="1"/>
          <site name="fingertip" pos="-0.003 0 -0.094" size="0.004"
                material="marker"/>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- q_spool = q_motor / gear_ratio. The default 5:1 ratio is replaced at
       runtime when transmission.gear_ratio changes. -->
  <equality>
    <joint name="gearbox_constraint"
           joint1="spool_joint" joint2="motor_shaft_joint"
           polycoef="0 0.2 0 0 0"
           solref="0.002 1" solimp="0.999 0.9999 0.0001"/>
    <joint name="guide_pulley_constraint"
           joint1="guide_pulley_joint" joint2="spool_joint"
           polycoef="0 -1.333333333333 0 0 0"
           solref="0.002 1" solimp="0.999 0.9999 0.0001"/>
  </equality>

  <tendon>
    <!-- Physics tendon. Its generalized length is
         finger_moment_arm*q_finger - spool_radius*q_spool.
         A wide upper deadband makes it unilateral: it pulls but never pushes. -->
    <fixed name="drive_tendon"
           springlength="-0.001 10"
           stiffness="850" damping="1.5">
      <joint joint="spool_joint" coef="-0.012"/>
      <joint joint="finger_joint" coef="0.018"/>
    </fixed>

    <!-- Visual cable routed from a rotating spool site, around a guide pulley,
         to the moving finger horn. It is force-free; drive_tendon supplies the
         actual compliant transmission force. -->
    <spatial name="cable_path" width="0.0014"
             rgba="0.86 0.10 0.08 1">
      <site site="spool_exit"/>
      <geom geom="guide_wrap" sidesite="guide_side"/>
      <site site="finger_tendon_anchor"/>
    </spatial>
  </tendon>

  <actuator>
    <motor name="motor_torque" joint="motor_shaft_joint"
           gear="1" ctrllimited="true" ctrlrange="0 0.35"/>
  </actuator>

  <sensor>
    <jointpos name="motor_encoder_position" joint="motor_shaft_joint"/>
    <jointvel name="motor_encoder_velocity" joint="motor_shaft_joint"/>
    <jointpos name="spool_position" joint="spool_joint"/>
    <jointvel name="spool_velocity" joint="spool_joint"/>
    <jointpos name="output_position" joint="finger_joint"/>
    <jointvel name="output_velocity" joint="finger_joint"/>
    <tendonpos name="drive_tendon_length" tendon="drive_tendon"/>
    <tendonvel name="drive_tendon_velocity" tendon="drive_tendon"/>
    <tendonpos name="cable_path_length" tendon="cable_path"/>
    <actuatorfrc name="motor_actuator_force" actuator="motor_torque"/>
  </sensor>
</mujoco>
